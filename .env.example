# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://shorty.sji.one
APP_URL=https://shorty.sji.one

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Connection string from MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=shorty

# ─── Upstash Redis ─────────────────────────────────────────────────────────────
# From Upstash Console → Database → REST API
UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# ─── Auth.js v5 ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=<your-32-char-random-secret>
# Required in production — set to your domain
AUTH_URL=https://shorty.sji.one

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Email of the account that has admin access
# Must match the email used to sign up for an account
ADMIN_EMAIL=your@email.com

# ─── Link Lifetime Limits ──────────────────────────────────────────────────────
# Max lifetime for anonymous links (hours). Default: 24
ANONYMOUS_MAX_LINK_LIFETIME_HOURS=24
# Max lifetime for authenticated user links (days). Default: 30
AUTHENTICATED_MAX_LINK_LIFETIME_DAYS=30

# ─── Redis Cache ───────────────────────────────────────────────────────────────
# How long link records are cached in Redis (seconds). Default: 3600 (1 hour)
REDIS_LINK_CACHE_TTL_SECONDS=3600

# ─── Rate Limits ───────────────────────────────────────────────────────────────
# Anonymous link creation: per IP per hour. Default: 5
RATE_LIMIT_ANON_CREATE_PER_HOUR=5
# Authenticated link creation: per user per hour. Default: 50
RATE_LIMIT_USER_CREATE_PER_HOUR=50
# General API endpoints: per IP per minute. Default: 30
RATE_LIMIT_API_PER_MINUTE=30
# Auth endpoints (login, signup): per IP per hour. Default: 10
RATE_LIMIT_AUTH_PER_HOUR=10

# ─── Short Code Settings ───────────────────────────────────────────────────────
# Length of auto-generated short codes. Default: 7
SHORT_CODE_LENGTH=7
# Custom alias min/max length. Defaults: 3 / 50
ALIAS_MIN_LENGTH=3
ALIAS_MAX_LENGTH=50
